<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agente_cambio_promotoria_list" model="ir.ui.view">
        <field name="name">bca.agente.cambio.promotoria.list</field>
        <field name="model">bca.agente.cambio.promotoria</field>
        <field name="arch" type="xml">
            <list string="Cambios de Promotoría">
                <field name="fecha_cambio"/>
                <field name="agente_id"/>
                <field name="promotoria_anterior_id"/>
                <field name="promotoria_nueva_id"/>
                <field name="motivo"/>
                <field name="usuario_id"/>
            </list>
        </field>
    </record>

    <record id="view_agente_cambio_promotoria_form" model="ir.ui.view">
        <field name="name">bca.agente.cambio.promotoria.form</field>
        <field name="model">bca.agente.cambio.promotoria</field>
        <field name="arch" type="xml">
            <form string="Cambio de Promotoría">
                <sheet>
                    <group>
                        <field name="fecha_cambio"/>
                        <field name="agente_id"/>
                        <field name="promotoria_anterior_id"/>
                        <field name="promotoria_nueva_id"/>
                        <field name="motivo"/>
                        <field name="usuario_id"/>
                        <field name="fecha_registro"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agente_cambio_promotoria" model="ir.actions.act_window">
        <field name="name">Cambios de Promotoría</field>
        <field name="res_model">bca.agente.cambio.promotoria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>