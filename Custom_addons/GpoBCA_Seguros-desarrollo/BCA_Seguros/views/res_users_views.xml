<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bca_existing_partner" model="ir.ui.view">
        <field name="name">res.users.form.bca.existing.partner</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <div class="o_row"
                     groups="BCA_Seguros.group_bca_director_comercial,BCA_Seguros.group_bca_director"
                     invisible="id">
                    <label for="partner_id" string="Contacto existente" class="o_form_label"/>
                    <field name="partner_id"
                           string="Contacto existente"
                           options="{'no_create': True}"
                           help="Selecciona contacto existente para evitar duplicar persona o Promotoria."/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
