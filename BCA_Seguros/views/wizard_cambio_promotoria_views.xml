<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_cambio_promotoria_form" model="ir.ui.view">
        <field name="name">bca.wizard.cambio.promotoria.form</field>
        <field name="model">bca.wizard.cambio.promotoria</field>
        <field name="arch" type="xml">
            <form string="Cambiar Promotoría">
                <sheet>
                    <group>
                        <field name="agente_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="promotoria_actual_id"/>
                        <field name="promotoria_nueva_id" options="{'no_create': True}"/>
                        <field name="fecha_cambio"/>
                        <field name="motivo" placeholder="Indique la razón del cambio..."/>
                    </group>
                    <group string="Impacto en cartera">
                        <field name="polizas_afectadas" readonly="1"/>
                        <field name="recibos_pendientes" readonly="1"/>
                        <field name="recibos_pagados" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Los recibos pagados conservan la Promotoría histórica y la PCA congelada.
                        Solo cambiará la Promotoría vigente del agente y de su cartera actual.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object"
                            string="Confirmar Cambio" class="btn-primary"
                            confirm="¿Confirmas el cambio de Promotoría?"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>